# ── Next.js / Vercel environment ────────────────────────────────────────────
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Convex deployment URL. Local dev: printed by `npx convex dev`.
# Production: set automatically by `npx convex deploy --cmd 'npm run build'`.
NEXT_PUBLIC_CONVEX_URL=

# Clerk (clerk.com) application keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google OAuth client ID (only the ID; the secret lives on Convex).
GOOGLE_CLIENT_ID=

# Vercel only: Convex production deploy key (Convex dashboard → Settings →
# Deploy keys). Lets the Vercel build push Convex functions.
# CONVEX_DEPLOY_KEY=

# ── Convex deployment environment ───────────────────────────────────────────
# Set these on the Convex deployment (dashboard → Settings → Environment
# Variables, or `npx convex env set NAME value`), NOT in this file.
#
# CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-subdomain>.clerk.accounts.dev
# ALLOWED_SIGNIN_DOMAINS=poweredbysage.com
# ALLOWED_SIGNIN_EMAILS=bretthoffman44@gmail.com
# GOOGLE_CLIENT_ID=<same client id as above>
# GOOGLE_CLIENT_SECRET=<google oauth client secret>
# GOOGLE_TOKEN_CIPHER_KEY=<base64 of 32 random bytes: `openssl rand -base64 32`>
# GOOGLE_EXPECTED_ACCOUNT=studio@poweredbysage.com
#
# AI extraction transport (first configured wins):
# AI_GATEWAY_API_KEY=<vercel ai gateway key (vck_…); model slugs are provider-prefixed>
# ANTHROPIC_API_KEY=<direct anthropic api key (fallback transport)>
# EXTRACTION_MODEL=anthropic/claude-sonnet-5.5   # gateway slug form; use claude-sonnet-5-5 for the direct route
